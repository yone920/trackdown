{
	"name": "trackdown-backend",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "TrackDown API — Better Auth (email + password), Postgres data layer, Claude log parser",
	"scripts": {
		"dev": "tsx watch src/server.ts",
		"build": "tsc -p tsconfig.build.json",
		"start": "node dist/server.js",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "eslint",
		"db:migrate": "tsx src/db/migrate.ts",
		"db:migrate-from-supabase": "tsx src/scripts/migrate-from-supabase.ts",
		"reset-password": "tsx src/scripts/reset-password.ts"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "^0.122.0",
		"@better-auth/core": "^1.7.2",
		"better-auth": "^1.7.2",
		"cors": "^2.8.5",
		"dotenv": "^17.2.3",
		"express": "^5.2.1",
		"express-rate-limit": "^8.2.1",
		"nodemailer": "^9.0.3",
		"pg": "^8.23.0",
		"zod": "^4.5.1"
	},
	"devDependencies": {
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.5",
		"@types/node": "^24.10.0",
		"@types/nodemailer": "^8.0.1",
		"@types/pg": "^8.20.0",
		"@types/supertest": "^6.0.3",
		"embedded-postgres": "^17.6.0-beta.15",
		"eslint": "^9.39.5",
		"supertest": "^7.2.2",
		"tsx": "^4.20.6",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.65.0",
		"vitest": "^4.1.11"
	},
	"allowScripts": {
		"@embedded-postgres/linux-x64@17.6.0-beta.15": true,
		"esbuild@0.28.2": true
	}
}
