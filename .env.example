# TrackDown backend configuration. Copy to backend/.env for local dev, or to
# .env.production next to docker-compose.yml for the Docker host.
# NEVER commit the real files — both are gitignored.

# ── Self-hosted Postgres (docker-compose.yml) ────────────────────────────────
POSTGRES_USER=trackdown
POSTGRES_PASSWORD=change-me            # openssl rand -base64 24
POSTGRES_DB=trackdown

# Local dev: the container from docker-compose.dev.yml
DATABASE_URL=postgres://trackdown:trackdown@localhost:5433/trackdown
# Production: compose derives it from POSTGRES_* above; no need to set it there.

# ── Better Auth ──────────────────────────────────────────────────────────────
BETTER_AUTH_SECRET=change-me           # openssl rand -base64 32 — rotating signs everyone out
# Public base URL of this API, as the phone reaches it. REQUIRED in production.
BETTER_AUTH_URL=https://trackdown-api.example.com
# Extra CORS/trusted origin for the Expo web target (optional; native apps need none)
APP_ORIGIN=

# ── Claude (free-text log parsing; was the Supabase edge function's secret) ──
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
# Required with identity-linked keys (Console → Settings → Workspaces → the workspace id, wrkspc_…)
ANTHROPIC_WORKSPACE_ID=

# ── SMTP for the sign-in code email ──────────────────────────────────────────
# Unset SMTP_HOST → codes are printed to the backend console (local dev only!)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false                      # true for implicit TLS on 465
EMAIL_FROM=TrackDown <noreply@yonelab.net>

# ── Expo app (put in the repo-root .env, read at bundle time) ────────────────
# EXPO_PUBLIC_API_URL=https://trackdown-api.example.com
