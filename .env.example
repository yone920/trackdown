# TrackDown backend configuration. Copy to backend/.env for local dev, or to
# .env.production next to docker-compose.yml for the Docker host.
# NEVER commit the real files — both are gitignored.

# ── Self-hosted Postgres (docker-compose.yml) ────────────────────────────────
POSTGRES_USER=trackdown
POSTGRES_PASSWORD=change-me            # openssl rand -base64 24
POSTGRES_DB=trackdown

# Local dev: the container from docker-compose.dev.yml
DATABASE_URL=postgres://trackdown:trackdown@localhost:5433/trackdown
# Production: compose derives it from POSTGRES_* above; no need to set it there.

# ── Better Auth ──────────────────────────────────────────────────────────────
BETTER_AUTH_SECRET=change-me           # openssl rand -base64 32 — rotating signs everyone out
# Public base URL of this API, as the phone reaches it. REQUIRED in production.
BETTER_AUTH_URL=https://trackdown-api.example.com
# Extra CORS/trusted origin for the Expo web target (optional; native apps need none)
APP_ORIGIN=

# ── AI providers ─────────────────────────────────────────────────────────────
# Every provider sits behind a port (backend/src/ports/), so switching one is an env
# var, not a refactor. An unknown provider name refuses to boot.

# anthropic | openai — used for log parsing and (WP2) photo fusion
LLM_PROVIDER=anthropic
# Defaults to LLM_PROVIDER. The coach (WP5) may run on a different provider.
COACH_LLM_PROVIDER=
# Model overrides. Defaults: anthropic claude-haiku-4-5 / claude-sonnet-4-5,
# openai gpt-4.1-mini / gpt-4.1.
LLM_MODEL_FUSION=
LLM_MODEL_COACH=

ANTHROPIC_API_KEY=
# Legacy name for LLM_MODEL_FUSION, still honoured when LLM_PROVIDER=anthropic.
ANTHROPIC_MODEL=claude-haiku-4-5
# Required with identity-linked keys (Console → Settings → Workspaces → the workspace id, wrkspc_…)
ANTHROPIC_WORKSPACE_ID=

OPENAI_API_KEY=
# Optional: an OpenAI-compatible gateway instead of api.openai.com
OPENAI_BASE_URL=

# Not read yet — the ports arrive with their work packages:
#   TRANSCRIPTION_PROVIDER=none|openai   cloud fallback for voice notes (WP8)
#   EVIDENCE_STORAGE=local|s3            where photos live (WP2)

# ── SMTP (unused today) ──────────────────────────────────────────────────────
# Auth is email + password, so nothing is emailed. The EmailPort
# (backend/src/ports/email.ts) is wired to the SMTP adapter for the day password-reset
# emails exist; until then, unset SMTP_HOST logs any message to the backend console and
# recovery is `cd backend && npm run reset-password -- <email> <newPassword>`.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false                      # true for implicit TLS on 465
EMAIL_FROM=TrackDown <noreply@yonelab.net>

# ── Expo app (put in the repo-root .env, read at bundle time) ────────────────
# EXPO_PUBLIC_API_URL=https://trackdown-api.example.com
